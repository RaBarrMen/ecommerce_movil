rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Cualquiera puede ver las fotos de los productos (público)
      allow read: if true;
      
      // Solo los usuarios registrados pueden subir archivos (fotos de perfil, etc.)
      allow write: if request.auth != null;
    }
  }
}